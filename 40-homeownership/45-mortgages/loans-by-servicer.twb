  <worksheets>
    <worksheet name='cbsa'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Light' fontsize='10' italic='true'>Loans originated for home purchase by race and ethnicity</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='loans-by-race' name='federated.06agby80t03t5u1av79xs0ti2efq' />
          </datasources>
          <datasource-dependencies datasource='federated.06agby80t03t5u1av79xs0ti2efq'>
            <column caption='Loan Purpose Code' datatype='string' name='[Calculation_278097282655952896]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [loan_purpose] = 1 THEN &quot;Home purchase&quot;&#13;&#10;ELSEIF [loan_purpose] = 2 THEN &quot;Home improvement&quot;&#13;&#10;ELSEIF [loan_purpose] = 31 THEN &quot;Refinancing&quot;&#13;&#10;ELSEIF [loan_purpose] = 32 THEN &quot;Cash-out refinancing&quot;&#13;&#10;ELSEIF [loan_purpose] = 4 THEN &quot;Other purpose&quot;&#13;&#10;ELSEIF [loan_purpose] = 5 THEN &quot;Not applicable&quot;&#13;&#10;END' />
            </column>
            <column caption='Occupancy Type Code' datatype='string' name='[Calculation_278097282656120833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [occupancy_type] = 1 THEN &quot;Principal Residence&quot;&#13;&#10;ELSEIF [occupancy_type] = 2 THEN &quot;Secondary Residence&quot;&#13;&#10;ELSEIF [occupancy_type] = 3 THEN &quot;Investment Property&quot;&#13;&#10;END' />
            </column>
            <column caption='Action Taken Code' datatype='string' name='[Calculation_278097282656555010]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [action_taken] = 1 THEN &quot;Loan originated&quot;&#13;&#10;ELSEIF [action_taken] = 2 THEN &quot;Application approved but not accepted&quot;&#13;&#10;ELSEIF  [action_taken] = 3 THEN &quot;Application denied&quot;&#13;&#10;ELSEIF [action_taken] = 4 THEN &quot;Application withdrawn by applicant&quot;&#13;&#10;ELSEIF [action_taken] = 5 THEN &quot;File closed for incompleteness&quot;&#13;&#10;ELSEIF [action_taken] = 6 THEN &quot;Purchased loan&quot;&#13;&#10;ELSEIF [action_taken] = 7 THEN &quot;Preapproval request denied&quot;&#13;&#10;ELSEIF [action_taken] = 8 THEN &quot;Preapproval request approved but not accepted&quot;&#13;&#10;END' />
            </column>
            <column caption='Race code' datatype='integer' name='[Calculation_278097282675634179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [derived_race]&#13;&#10;WHEN &quot;2 or more minority races&quot; THEN 1&#13;&#10;WHEN &quot;American Indian or Alaska Native&quot; THEN 2&#13;&#10;WHEN &quot;Asian&quot; THEN 3&#13;&#10;WHEN &quot;Black or African American&quot; THEN 4&#13;&#10;WHEN &quot;Free Form Text Only&quot; THEN 5&#13;&#10;WHEN &quot;Joint&quot; THEN 6&#13;&#10;WHEN &quot;Native Hawaiian or Other Pacific Islander&quot; THEN 7&#13;&#10;WHEN &quot;Race Not Available&quot; THEN 8&#13;&#10;WHEN &quot;White&quot; THEN 9&#13;&#10;END' />
            </column>
            <column caption='Ethnicity code' datatype='integer' name='[Calculation_278097282680393732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [derived_ethnicity]&#13;&#10;WHEN &quot;Not Hispanic or Latino&quot; THEN 1&#13;&#10;WHEN &quot;Hispanic or Latino&quot; THEN 2&#13;&#10;WHEN &quot;Joint&quot; THEN 3&#13;&#10;WHEN &quot;Ethnicity Not Available&quot; THEN 4&#13;&#10;END' />
            </column>
            <column caption='Race and ethnicity' datatype='string' name='[Calculation_278097282680815621]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_278097282675634179] = 1 AND [Calculation_278097282680393732] = 1 THEN &quot;Multiracial&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 1 AND [Calculation_278097282680393732] = 2 THEN &quot;Hispanic or Latino&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 1 AND [Calculation_278097282680393732] = 3 THEN &quot;Multiracial&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 1 AND [Calculation_278097282680393732] = 4 THEN &quot;Multiracial&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 2 AND [Calculation_278097282680393732] = 1 THEN &quot;American Indian or Alaska Native&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 2 AND [Calculation_278097282680393732] = 2 THEN &quot;Hispanic or Latino&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 2 AND [Calculation_278097282680393732] = 3 THEN &quot;American Indian or Alaska Native&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 2 AND [Calculation_278097282680393732] = 4 THEN &quot;American Indian or Alaska Native&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 3 AND [Calculation_278097282680393732] = 1 THEN &quot;Asian&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 3 AND [Calculation_278097282680393732] = 2 THEN &quot;Hispanic or Latino&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 3 AND [Calculation_278097282680393732] = 3 THEN &quot;Asian&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 3 AND [Calculation_278097282680393732] = 4 THEN &quot;Asian&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 4 AND [Calculation_278097282680393732] = 1 THEN &quot;Black or African American&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 4 AND [Calculation_278097282680393732] = 2 THEN &quot;Hispanic or Latino&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 4 AND [Calculation_278097282680393732] = 3 THEN &quot;Black or African American&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 4 AND [Calculation_278097282680393732] = 4 THEN &quot;Black or African American&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 5 AND [Calculation_278097282680393732] = 1 THEN &quot;Free Form Text Only&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 5 AND [Calculation_278097282680393732] = 2 THEN &quot;Hispanic or Latino&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 5 AND [Calculation_278097282680393732] = 3 THEN &quot;Free Form Text Only&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 5 AND [Calculation_278097282680393732] = 4 THEN &quot;Free Form Text Only&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 6 AND [Calculation_278097282680393732] = 1 THEN &quot;Joint&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 6 AND [Calculation_278097282680393732] = 2 THEN &quot;Hispanic or Latino&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 6 AND [Calculation_278097282680393732] = 3 THEN &quot;Joint&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 6 AND [Calculation_278097282680393732] = 4 THEN &quot;Joint&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 7 AND [Calculation_278097282680393732] = 1 THEN &quot;Native Hawaiian or other Pacific Islander&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 7 AND [Calculation_278097282680393732] = 2 THEN &quot;Hispanic or Latino&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 7 AND [Calculation_278097282680393732] = 3 THEN &quot;Native Hawaiian or other Pacific Islander&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 7 AND [Calculation_278097282680393732] = 4 THEN &quot;Native Hawaiian or other Pacific Islander&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 8 AND [Calculation_278097282680393732] = 1 THEN &quot;Incomplete data&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 8 AND [Calculation_278097282680393732] = 2 THEN &quot;Hispanic or Latino&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 8 AND [Calculation_278097282680393732] = 3 THEN &quot;Incomplete data&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 8 AND [Calculation_278097282680393732] = 4 THEN &quot;Incomplete data&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 9 AND [Calculation_278097282680393732] = 1 THEN &quot;White, non-Hispanic&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 9 AND [Calculation_278097282680393732] = 2 THEN &quot;Hispanic or Latino&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 9 AND [Calculation_278097282680393732] = 3 THEN &quot;White, non-Hispanic&quot;&#13;&#10;ELSEIF [Calculation_278097282675634179] = 9 AND [Calculation_278097282680393732] = 4 THEN &quot;White, non-Hispanic&quot;&#13;&#10;END' />
            </column>
