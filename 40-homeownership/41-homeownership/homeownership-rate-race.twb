      <aliases enabled='yes' />
      <column caption='Homeownership rate' datatype='real' name='[Calculation_1004302779991048192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([est_owner])/SUM([est_all])' />
      </column>
      <column datatype='string' name='[Locality (group)]' role='dimension' semantic-role='' type='nominal'>
        <calculation class='categorical-bin' column='[locality]' new-bin='true'>
          <bin default-name='false' value='&quot;Bedford County&quot;'>
            <value>&quot;Bedford city&quot;</value>
            <value>&quot;Bedford County&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Race (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[race]' new-bin='true'>
          <bin default-name='false' value='&quot;Another race including multiracial&quot;'>
            <value>&quot;American Indian and Alaska Native&quot;</value>
            <value>&quot;Native Hawaiian and Other Pacific Islander&quot;</value>
            <value>&quot;Some Other Race&quot;</value>
            <value>&quot;Two or More Races&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;White, non-Hispanic&quot;'>
            <value>&quot;White, Not Hispanic or Latino &quot;</value>
          </bin>
        </calculation>
      </column>
