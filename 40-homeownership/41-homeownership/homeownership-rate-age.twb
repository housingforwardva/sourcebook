      <aliases enabled='yes' />
      <column datatype='string' name='[Age (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[age]' new-bin='true'>
          <bin default-name='false' value='&quot;25 to 44 years&quot;'>
            <value>&quot;Householder 25 to 34 years&quot;</value>
            <value>&quot;Householder 35 to 44 years&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;46 to 64 years&quot;'>
            <value>&quot;Householder 45 to 54 years&quot;</value>
            <value>&quot;Householder 55 to 59 years&quot;</value>
            <value>&quot;Householder 60 to 64 years&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;65 years and over&quot;'>
            <value>&quot;Householder 65 to 74 years&quot;</value>
            <value>&quot;Householder 75 to 84 years&quot;</value>
            <value>&quot;Householder 85 years and over&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Under 25 years&quot;'>
            <value>&quot;Householder 15 to 24 years&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Homeowners' datatype='integer' name='[Calculation_1982991215243583488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [tenure] = &quot;Owner occupied&quot; THEN [estimate]&#13;&#10;END' />
      </column>
      <column caption='Total households' datatype='integer' name='[Calculation_1982991215243911169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Total(sum([estimate]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Homeownership rate' datatype='real' name='[Calculation_1982991215243997186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1982991215243583488])/[Calculation_1982991215243911169]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
