  <worksheets>
    <worksheet name='cbsa'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555' fontsize='10' italic='true'>Homeownership rate by age group</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='b25007' name='federated.1bjl76909hgne814sncf613d5khy' />
          </datasources>
          <datasource-dependencies datasource='federated.1bjl76909hgne814sncf613d5khy'>
            <column datatype='string' name='[Age (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[age]' new-bin='true'>
                <bin default-name='false' value='&quot;25 to 44 years&quot;'>
                  <value>&quot;Householder 25 to 34 years&quot;</value>
                  <value>&quot;Householder 35 to 44 years&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;46 to 64 years&quot;'>
                  <value>&quot;Householder 45 to 54 years&quot;</value>
                  <value>&quot;Householder 55 to 59 years&quot;</value>
                  <value>&quot;Householder 60 to 64 years&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;65 years and over&quot;'>
                  <value>&quot;Householder 65 to 74 years&quot;</value>
                  <value>&quot;Householder 75 to 84 years&quot;</value>
                  <value>&quot;Householder 85 years and over&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Under 25 years&quot;'>
                  <value>&quot;Householder 15 to 24 years&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Homeowners' datatype='integer' name='[Calculation_1982991215243583488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [tenure] = &quot;Owner occupied&quot; THEN [estimate]&#13;&#10;END' />
            </column>
            <column caption='Total households' datatype='integer' name='[Calculation_1982991215243911169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Total(sum([estimate]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Homeownership rate' datatype='real' name='[Calculation_1982991215243997186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1982991215243583488])/[Calculation_1982991215243911169]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Age' datatype='string' name='[age]' role='dimension' type='nominal' />
            <column-instance column='[cbsa_title]' derivation='Attribute' name='[attr:cbsa_title:nk]' pivot='key' type='nominal' />
            <column caption='Cbsa Title' datatype='string' name='[cbsa_title]' role='dimension' type='nominal' />
            <column caption='Estimate' datatype='integer' name='[estimate]' role='measure' type='quantitative' />
            <column-instance column='[cbsa_title]' derivation='None' name='[none:cbsa_title:nk]' pivot='key' type='nominal' />
            <column-instance column='[tenure]' derivation='None' name='[none:tenure:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1982991215243583488]' derivation='Sum' name='[sum:Calculation_1982991215243583488:qk]' pivot='key' type='quantitative' />
            <column caption='Tenure' datatype='string' name='[tenure]' role='dimension' type='nominal' />
            <column-instance column='[year]' derivation='Year-Trunc' name='[tyr:year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1982991215243997186]' derivation='User' name='[usr:Calculation_1982991215243997186:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-field='' ordering-type='Field' />
              <table-calc field='[federated.1bjl76909hgne814sncf613d5khy].[Calculation_1982991215243911169]' ordering-field='' ordering-type='Field' />
            </column-instance>
            <column caption='Year' datatype='date' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1bjl76909hgne814sncf613d5khy].[Age (group)]'>
