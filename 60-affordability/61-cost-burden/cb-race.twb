                <bin default-name='false' value='&quot;Cost-burdened (Greater than 30\% or no/negative income)&quot;'>
                  <value>&quot;greater than 30\% but less than or equal to 50\%&quot;</value>
                  <value>&quot;greater than 50\%&quot;</value>
                  <value>&quot;not computed (no/negative income)&quot;</value>
