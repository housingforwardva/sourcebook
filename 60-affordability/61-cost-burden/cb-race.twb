                <alias key='&quot;greater than 50\%&quot;' value='Severely cost-burdened (&gt;50%)' />
                <alias key='&quot;less than or equal to 30\%&quot;' value='Not cost-burdened (&lt;30%)' />
                <alias key='&quot;not computed (no/negative income)&quot;' value='No or negative income' />
