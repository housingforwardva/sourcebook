              <calculation class='tableau' formula='CASE [Rent]&#13;&#10;WHEN &quot;less than or equal to RHUD30&quot; THEN 1&#13;&#10;WHEN &quot;greater than RHUD30 and less than or equal to RHUD50&quot; THEN 2&#13;&#10;WHEN &quot;greater than RHUD50 and less than or equal to RHUD80&quot; THEN 3&#13;&#10;WHEN &quot;greater than RHUD80&quot; THEN 4&#13;&#10;END' />
