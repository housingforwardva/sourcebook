      <column caption='Rent Code' datatype='integer' name='[Calculation_140174606034120704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Rent]&#13;&#10;WHEN &quot;less than or equal to RHUD30&quot; THEN 1&#13;&#10;WHEN &quot;greater than RHUD30 and less than or equal to RHUD50&quot; THEN 2&#13;&#10;WHEN &quot;greater than RHUD50 and less than or equal to RHUD80&quot; THEN 3&#13;&#10;WHEN &quot;greater than RHUD80&quot; THEN 4&#13;&#10;END' />
      </column>
      <column caption='Income Code' datatype='integer' name='[Calculation_140174606034579457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Household income (group)]&#13;&#10;WHEN &quot;Extremely low income (≤ 30% AMI)&quot; THEN 1&#13;&#10;WHEN &quot;Very low income (30-50% AMI)&quot; THEN 2&#13;&#10;WHEN &quot;Low income (50-80% AMI)&quot; THEN 3&#13;&#10;WHEN &quot;Moderate Income or More (&gt; 80% AMI)&quot; THEN 4&#13;&#10;END' />
      </column>
      <column caption='Match Code' datatype='string' name='[Calculation_140174606034776066]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_140174606034579457] = 1 AND [Calculation_140174606034120704] = 1) THEN &quot;Affordable&quot;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 1 AND [Calculation_140174606034120704] = 2) THEN &quot;Unaffordable&quot;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 1 AND  [Calculation_140174606034120704] = 3)THEN &quot;Unaffordable&quot;&#13;&#10;ELSEIF [Calculation_140174606034579457] = 1 AND [Calculation_140174606034120704] = 4 THEN &quot;Unaffordable&quot;&#13;&#10;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 2 AND [Calculation_140174606034120704] = 1) THEN &quot;Very affordable&quot;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 2 AND [Calculation_140174606034120704] = 2) THEN &quot;Affordable&quot;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 2 AND [Calculation_140174606034120704] = 3) THEN &quot;Unaffordable&quot;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 2 AND [Calculation_140174606034120704] = 4) THEN &quot;Unaffordable&quot;&#13;&#10;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 3 AND [Calculation_140174606034120704] = 1) THEN &quot;Very affordable&quot;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 3 AND [Calculation_140174606034120704] = 2) THEN &quot;Very affordable&quot;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 3 AND [Calculation_140174606034120704] = 3) THEN &quot;Affordable&quot;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 3 AND [Calculation_140174606034120704] = 4) THEN &quot;Unaffordable&quot;&#13;&#10;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 4 AND [Calculation_140174606034120704] = 1) THEN &quot;Very affordable&quot;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 4 AND [Calculation_140174606034120704] = 2) THEN &quot;Very affordable&quot;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 4 AND [Calculation_140174606034120704] = 3) THEN &quot;Very affordable&quot;&#13;&#10;ELSEIF ([Calculation_140174606034579457] = 4 AND [Calculation_140174606034120704] = 4) THEN &quot;Affordable&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Deficit' datatype='integer' name='[Calculation_140174606034882563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_140174606034776066] = &quot;Unaffordable&quot; THEN -[Estimate]&#13;&#10;END' />
      </column>
      <column caption='Match value' datatype='integer' name='[Calculation_1693072052576931840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_140174606034776066]&#13;&#10;WHEN &quot;Unaffordable&quot; THEN -([Estimate])&#13;&#10;WHEN &quot;Affordable&quot; THEN ([Estimate])&#13;&#10;WHEN &quot;Very affordable&quot; THEN ([Estimate])&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Estimate (copy)' datatype='integer' name='[Estimate (copy)_981221836471291904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Estimate]' />
      </column>
      <column datatype='string' name='[Household income (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Household income]' new-bin='true'>
          <bin default-name='false' value='&quot;Extremely low income (≤ 30\% AMI)&quot;'>
            <value>&quot;less than or equal to 30\% of HAMFI&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Low income (50-80\% AMI)&quot;'>
            <value>&quot;greater than 50\% of HAMFI but less than or equal to 80\% of HAMFI&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Moderate Income or More (&gt; 80\% AMI)&quot;'>
            <value>&quot;greater than 100\% of HAMFI&quot;</value>
            <value>&quot;greater than 80\% of HAMFI but less than or equal to 100\% of HAMFI&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Very low income (30-50\% AMI)&quot;'>
            <value>&quot;greater than 30\% of HAMFI but less than or equal to 50\% of HAMFI&quot;</value>
          </bin>
        </calculation>
      </column>
