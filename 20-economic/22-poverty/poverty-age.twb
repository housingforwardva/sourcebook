  <worksheets>
    <worksheet name='cbsa'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555' fontsize='10' italic='true'>Poverty rate for population which poverty status can be determined</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='poverty' name='federated.1bjl76909hgne814sncf613d5khy' />
          </datasources>
          <datasource-dependencies datasource='federated.1bjl76909hgne814sncf613d5khy'>
            <column datatype='string' name='[Age (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[age]' new-bin='true'>
                <bin default-name='false' value='&quot;25 to 44 years&quot;'>
                  <value>&quot;25 to 34 years&quot;</value>
                  <value>&quot;35 to 44 years&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;45 to 64 years&quot;'>
                  <value>&quot;45 to 54 years&quot;</value>
                  <value>&quot;55 to 64 years&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;65 years and over&quot;'>
                  <value>&quot;65 to 74 years&quot;</value>
                  <value>&quot;75 years and over&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Under 18 years&quot;'>
                  <value>&quot;12 to 14 years&quot;</value>
                  <value>&quot;15 years&quot;</value>
                  <value>&quot;16 and 17 years&quot;</value>
                  <value>&quot;5 years&quot;</value>
                  <value>&quot;6 to 11 years&quot;</value>
                  <value>&quot;Under 5 years&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Poverty estimate' datatype='integer' name='[Calculation_1023161544556691457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [poverty] = &quot;Income in the past 12 months below poverty level&quot; THEN [estimate]&#13;&#10;END' />
            </column>
            <column caption='Poverty rate' datatype='real' default-format='p0.0%' name='[Calculation_1023161544556888066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1023161544556691457])/total(sum([estimate]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Age' datatype='string' name='[age]' role='dimension' type='nominal' />
