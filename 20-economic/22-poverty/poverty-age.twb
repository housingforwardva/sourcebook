              <bucket>&quot;18 to 24 years&quot;</bucket>
              <bucket>&quot;25 to 44 years&quot;</bucket>
              <bucket>&quot;45 to 64 years&quot;</bucket>
              <bucket>&quot;65 years and over&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.1bjl76909hgne814sncf613d5khy].[none:poverty:nk]'>
            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:poverty:nk]' member='&quot;Income in the past 12 months at or above poverty level&quot;' />
              <groupfilter function='member' level='[none:poverty:nk]' member='&quot;Income in the past 12 months below poverty level&quot;' />
            </groupfilter>
