    <worksheet name='subsidy'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10' italic='true'>Total assisted units by federal subsidy</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='va_subsidies_geocoded.csv+ (Multiple Connections)' name='federated.1yttdds1injy9g18kghzc0q3ctf3' />
          </datasources>
          <datasource-dependencies datasource='federated.1yttdds1injy9g18kghzc0q3ctf3'>
            <column datatype='integer' name='[Assisted Units]' role='measure' type='quantitative' />
            <column caption='Name' datatype='string' name='[NAME]' role='dimension' type='nominal' />
            <column caption='Property Name (copy)' datatype='string' name='[Property Name (copy)_1597933459062550528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Property Name]' />
            </column>
            <column datatype='string' name='[Property Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[Subsidy Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[Subsidy Status]' role='dimension' type='nominal' />
            <column datatype='string' name='[Subsidy]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Subsidy Name]' new-bin='true'>
                <bin default-name='false' value='&quot;Section 202 or Section 236&quot;'>
                  <value>&quot;Section 202&quot;</value>
                  <value>&quot;Section 236&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;USDA&quot;'>
                  <value>&quot;RHS 515&quot;</value>
                  <value>&quot;RHS 538&quot;</value>
                </bin>
              </calculation>
            </column>
            <column-instance column='[Property Name (copy)_1597933459062550528]' derivation='None' name='[none:Property Name (copy)_1597933459062550528:nk]' pivot='key' type='nominal' />
            <column-instance column='[Subsidy Name]' derivation='None' name='[none:Subsidy Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Subsidy Status]' derivation='None' name='[none:Subsidy Status:nk]' pivot='key' type='nominal' />
            <column-instance column='[Assisted Units]' derivation='Sum' name='[sum:Assisted Units:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1yttdds1injy9g18kghzc0q3ctf3].[Action (Name)]'>
            <groupfilter function='level-members' level='[NAME]' user:ui-action-filter='[Action1_C3A92028EFFE4031ADB6360F251C56A5]' user:ui-enumeration='all' user:ui-marker='enumerate' />
